{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"$id": "https://samuraiwriter7.github.io/royalty-os/schemas/policy-module.schema.json",
"title": "Royalty OS Policy Module Schema",
"description": "Schema for Royalty OS v0.4 Policy Modules. Policy modules guide review and governance interpretation without automatically deciding value, enforcing compensation, or replacing human judgment.",
"type": "object",
"additionalProperties": false,
"required": [
"schema_version",
"object_type",
"policy_id",
"policy_name",
"policy_version",
"status",
"module_type",
"scope",
"applies_to",
"rules",
"boundary_constraints"
],
"properties": {
"schema_version": {
"type": "string",
"const": "0.4.0-draft"
},
"object_type": {
"type": "string",
"const": "policy_module"
},
"policy_id": {
"$ref": "#/$defs/identifier"
},
"policy_name": {
"type": "string",
"minLength": 1
},
"policy_version": {
"type": "string",
"minLength": 1
},
"status": {
"type": "string",
"enum": [
"draft",
"active",
"experimental",
"deprecated",
"archived"
]
},
"module_type": {
"type": "string",
"enum": [
"attribution_policy",
"contribution_policy",
"review_policy",
"dispute_policy",
"redistribution_policy",
"archival_policy",
"migration_policy",
"custom_policy"
]
},
"description": {
"type": "string"
},
"metadata": {
"$ref": "#/$defs/metadata"
},
"scope": {
"$ref": "#/$defs/policy_scope"
},
"applies_to": {
"type": "array",
"minItems": 1,
"items": {
"type": "string",
"enum": [
"node",
"edge",
"graph",
"graph_layer",
"value_record",
"value_event",
"policy_module",
"governance_action",
"os_event",
"migration_event",
"review_state"
]
},
"uniqueItems": true
},
"rules": {
"type": "array",
"minItems": 1,
"items": {
"$ref": "#/$defs/policy_rule"
}
},
"review_requirements": {
"$ref": "#/$defs/review_requirements"
},
"boundary_constraints": {
"$ref": "#/$defs/boundary_constraints"
},
"governance_constraints": {
"$ref": "#/$defs/governance_constraints"
},
"compatibility": {
"$ref": "#/$defs/compatibility"
},
"notes": {
"type": "string"
}
},
"$defs": {
"identifier": {
"type": "string",
"minLength": 1,
"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
},
"timestamp": {
"type": "string",
"format": "date-time"
},
"metadata": {
"type": "object",
"additionalProperties": false,
"required": [
"created_at",
"created_by",
"spec_reference"
],
"properties": {
"created_at": {
"$ref": "#/$defs/timestamp"
},
"updated_at": {
"$ref": "#/$defs/timestamp"
},
"created_by": {
"type": "string",
"minLength": 1
},
"spec_reference": {
"type": "string",
"const": "specs/royalty-os-v0.4-draft.yaml"
},
"structural_diff_reference": {
"type": "string",
"const": "docs/v0.4-structural-diff.md"
},
"notes": {
"type": "string"
}
}
},
"policy_scope": {
"type": "object",
"additionalProperties": false,
"required": [
"scope_type",
"description"
],
"properties": {
"scope_type": {
"type": "string",
"enum": [
"repository",
"project",
"document",
"graph",
"graph_layer",
"relationship",
"organization",
"community",
"custom"
]
},
"description": {
"type": "string",
"minLength": 1
},
"included_targets": {
"type": "array",
"items": {
"$ref": "#/$defs/identifier"
},
"uniqueItems": true
},
"excluded_targets": {
"type": "array",
"items": {
"$ref": "#/$defs/identifier"
},
"uniqueItems": true
}
}
},
"policy_rule": {
"type": "object",
"additionalProperties": false,
"required": [
"rule_id",
"rule_type",
"description",
"guidance_level"
],
"properties": {
"rule_id": {
"$ref": "#/$defs/identifier"
},
"rule_type": {
"type": "string",
"enum": [
"attribution_guidance",
"contribution_assessment",
"review_requirement",
"dispute_handling",
"redistribution_guidance",
"archival_guidance",
"migration_guidance",
"boundary_protection",
"custom"
]
},
"description": {
"type": "string",
"minLength": 1
},
"guidance_level": {
"type": "string",
"enum": [
"informational",
"recommended",
"required_for_review",
"requires_human_review",
"prohibited"
]
},
"applies_to": {
"type": "array",
"items": {
"type": "string",
"enum": [
"node",
"edge",
"graph",
"graph_layer",
"policy_module",
"governance_action",
"os_event",
"review_state"
]
},
"uniqueItems": true
},
"condition": {
"type": "object",
"additionalProperties": true
},
"recommended_action": {
"type": "string"
},
"prohibited_actions": {
"type": "array",
"items": {
"type": "string"
},
"uniqueItems": true
},
"evidence_requirements": {
"type": "array",
"items": {
"type": "string"
},
"uniqueItems": true
},
"notes": {
"type": "string"
}
}
},
"review_requirements": {
"type": "object",
"additionalProperties": false,
"properties": {
"review_required": {
"type": "boolean"
},
"review_mode": {
"type": "string",
"enum": [
"human_reviewed",
"ai_assisted",
"policy_guided",
"human_reviewed_ai_assisted",
"not_required"
]
},
"minimum_review_status": {
"type": "string",
"enum": [
"unreviewed",
"pending_review",
"reviewed",
"approved_for_record",
"disputed",
"rejected",
"archived"
]
},
"requires_reviewer_notes": {
"type": "boolean"
},
"requires_evidence_references": {
"type": "boolean"
}
}
},
"boundary_constraints": {
"type": "object",
"additionalProperties": false,
"required": [
"scoring_boundary",
"execution_boundary"
],
"properties": {
"scoring_boundary": {
"type": "object",
"additionalProperties": false,
"required": [
"enabled",
"statement"
],
"properties": {
"enabled": {
"type": "boolean"
},
"statement": {
"type": "string",
"minLength": 1
},
"prohibits": {
"type": "array",
"items": {
"type": "string",
"enum": [
"automatic_value_judgment",
"score_as_final_decision",
"unreviewed_attribution_finalization"
]
},
"uniqueItems": true
}
}
},
"execution_boundary": {
"type": "object",
"additionalProperties": false,
"required": [
"enabled",
"statement"
],
"properties": {
"enabled": {
"type": "boolean"
},
"statement": {
"type": "string",
"minLength": 1
},
"prohibits": {
"type": "array",
"items": {
"type": "string",
"enum": [
"automatic_compensation_execution",
"automatic_legal_enforcement",
"automatic_punitive_action",
"automatic_final_attribution"
]
},
"uniqueItems": true
}
}
}
}
},
"governance_constraints": {
"type": "object",
"additionalProperties": false,
"properties": {
"allowed_governance_actions": {
"type": "array",
"items": {
"type": "string",
"enum": [
"acknowledge",
"flag",
"defer",
"merge",
"split",
"revise",
"escalate",
"reject",
"archive"
]
},
"uniqueItems": true
},
"requires_governance_reason": {
"type": "boolean"
},
"requires_policy_reference": {
"type": "boolean"
},
"requires_human_approval_for_execution": {
"type": "boolean"
}
}
},
"compatibility": {
"type": "object",
"additionalProperties": false,
"properties": {
"compatible_with": {
"type": "array",
"items": {
"type": "string",
"enum": [
"v0.3",
"v0.4-draft"
]
},
"uniqueItems": true
},
"replaces_policy_id": {
"$ref": "#/$defs/identifier"
},
"migration_notes": {
"type": "string"
}
}
}
}
}
