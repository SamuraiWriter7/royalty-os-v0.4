{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"$id": "https://samuraiwriter7.github.io/royalty-os/schemas/value-graph-v2.schema.json",
"title": "Royalty OS Value Graph v2 Schema",
"description": "Schema for the Royalty OS v0.4 Multi-Layer Value Graph. This schema defines layered value relationships while preserving review, policy, governance, and execution boundaries.",
"type": "object",
"additionalProperties": false,
"required": [
"schema_version",
"object_type",
"graph_id",
"title",
"metadata",
"layers",
"nodes",
"edges"
],
"properties": {
"schema_version": {
"type": "string",
"const": "0.4.0-draft"
},
"object_type": {
"type": "string",
"const": "multi_layer_value_graph"
},
"graph_id": {
"$ref": "#/$defs/identifier"
},
"title": {
"type": "string",
"minLength": 1
},
"description": {
"type": "string"
},
"metadata": {
"$ref": "#/$defs/metadata"
},
"layers": {
"type": "array",
"minItems": 1,
"items": {
"$ref": "#/$defs/graph_layer"
}
},
"nodes": {
"type": "array",
"minItems": 1,
"items": {
"$ref": "#/$defs/graph_node"
}
},
"edges": {
"type": "array",
"items": {
"$ref": "#/$defs/graph_edge"
}
},
"boundary_model": {
"$ref": "#/$defs/boundary_model"
},
"compatibility": {
"$ref": "#/$defs/compatibility"
},
"review_context": {
"$ref": "#/$defs/review_context"
}
},
"$defs": {
"identifier": {
"type": "string",
"minLength": 1,
"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
},
"timestamp": {
"type": "string",
"format": "date-time"
},
"metadata": {
"type": "object",
"additionalProperties": false,
"required": [
"created_at",
"created_by",
"spec_reference"
],
"properties": {
"created_at": {
"$ref": "#/$defs/timestamp"
},
"updated_at": {
"$ref": "#/$defs/timestamp"
},
"created_by": {
"type": "string",
"minLength": 1
},
"spec_reference": {
"type": "string",
"const": "specs/royalty-os-v0.4-draft.yaml"
},
"structural_diff_reference": {
"type": "string",
"const": "docs/v0.4-structural-diff.md"
},
"source_version": {
"type": "string",
"enum": [
"v0.1",
"v0.2",
"v0.3",
"v0.4-draft"
]
},
"notes": {
"type": "string"
}
}
},
"graph_layer": {
"type": "object",
"additionalProperties": false,
"required": [
"layer_id",
"layer_type",
"name",
"status"
],
"properties": {
"layer_id": {
"$ref": "#/$defs/identifier"
},
"layer_type": {
"type": "string",
"enum": [
"contribution_layer",
"reference_layer",
"derivation_layer",
"review_layer",
"policy_layer",
"governance_layer",
"event_layer",
"custom_layer"
]
},
"name": {
"type": "string",
"minLength": 1
},
"description": {
"type": "string"
},
"status": {
"type": "string",
"enum": [
"active",
"experimental",
"deprecated"
]
},
"order": {
"type": "integer",
"minimum": 0
},
"applies_to": {
"type": "array",
"items": {
"type": "string",
"enum": [
"node",
"edge",
"graph",
"policy_module",
"governance_action",
"os_event",
"review_state"
]
},
"uniqueItems": true
}
}
},
"graph_node": {
"type": "object",
"additionalProperties": false,
"required": [
"node_id",
"node_type",
"label"
],
"properties": {
"node_id": {
"$ref": "#/$defs/identifier"
},
"node_type": {
"type": "string",
"enum": [
"human",
"ai_system",
"work",
"prompt",
"output",
"dataset",
"model",
"document",
"repository",
"value_record",
"value_event",
"policy_module",
"governance_action",
"os_event",
"review_state",
"custom"
]
},
"label": {
"type": "string",
"minLength": 1
},
"description": {
"type": "string"
},
"source_reference": {
"type": "string"
},
"created_at": {
"$ref": "#/$defs/timestamp"
},
"attributes": {
"type": "object",
"additionalProperties": true
}
}
},
"graph_edge": {
"type": "object",
"additionalProperties": false,
"required": [
"edge_id",
"layer_id",
"source_node_id",
"target_node_id",
"relationship_type"
],
"properties": {
"edge_id": {
"$ref": "#/$defs/identifier"
},
"layer_id": {
"$ref": "#/$defs/identifier"
},
"source_node_id": {
"$ref": "#/$defs/identifier"
},
"target_node_id": {
"$ref": "#/$defs/identifier"
},
"relationship_type": {
"type": "string",
"enum": [
"contribution",
"reference",
"derivation",
"review_status",
"policy_application",
"governance_action",
"os_event_link",
"compatibility_mapping",
"custom"
]
},
"direction": {
"type": "string",
"enum": [
"directed",
"undirected"
],
"default": "directed"
},
"description": {
"type": "string"
},
"confidence": {
"type": "number",
"minimum": 0,
"maximum": 1
},
"review_status": {
"type": "string",
"enum": [
"unreviewed",
"pending_review",
"reviewed",
"approved_for_record",
"disputed",
"rejected",
"archived"
]
},
"boundary_classification": {
"type": "string",
"enum": [
"signal",
"review",
"policy",
"governance",
"execution"
]
},
"policy_references": {
"type": "array",
"items": {
"$ref": "#/$defs/identifier"
},
"uniqueItems": true
},
"evidence_references": {
"type": "array",
"items": {
"type": "string"
}
},
"created_at": {
"$ref": "#/$defs/timestamp"
},
"attributes": {
"type": "object",
"additionalProperties": true
}
}
},
"boundary_model": {
"type": "object",
"additionalProperties": false,
"required": [
"scoring_boundary",
"execution_boundary"
],
"properties": {
"scoring_boundary": {
"type": "object",
"additionalProperties": false,
"required": [
"enabled",
"statement"
],
"properties": {
"enabled": {
"type": "boolean"
},
"statement": {
"type": "string"
},
"separates": {
"type": "object",
"additionalProperties": false,
"properties": {
"from": {
"type": "string",
"const": "signal_assessment"
},
"to": {
"type": "string",
"const": "final_value_judgment"
}
}
}
}
},
"execution_boundary": {
"type": "object",
"additionalProperties": false,
"required": [
"enabled",
"statement"
],
"properties": {
"enabled": {
"type": "boolean"
},
"statement": {
"type": "string"
},
"separates": {
"type": "object",
"additionalProperties": false,
"properties": {
"from": {
"type": "string",
"const": "governance_recommendation"
},
"to": {
"type": "string",
"const": "automatic_execution"
}
}
}
}
}
}
},
"compatibility": {
"type": "object",
"additionalProperties": false,
"properties": {
"compatible_with": {
"type": "array",
"items": {
"type": "string",
"enum": [
"v0.1",
"v0.2",
"v0.3"
]
},
"uniqueItems": true
},
"v0_3_graph_id": {
"$ref": "#/$defs/identifier"
},
"migration_status": {
"type": "string",
"enum": [
"not_started",
"partial",
"completed",
"not_applicable"
]
},
"migration_notes": {
"type": "string"
},
"mapped_from": {
"type": "array",
"items": {
"type": "object",
"additionalProperties": false,
"required": [
"from_path",
"to_path"
],
"properties": {
"from_path": {
"type": "string"
},
"to_path": {
"type": "string"
},
"notes": {
"type": "string"
}
}
}
}
}
},
"review_context": {
"type": "object",
"additionalProperties": false,
"properties": {
"review_required": {
"type": "boolean"
},
"review_mode": {
"type": "string",
"enum": [
"human_reviewed",
"ai_assisted",
"policy_guided",
"human_reviewed_ai_assisted",
"not_required"
]
},
"review_notes": {
"type": "string"
},
"reviewers": {
"type": "array",
"items": {
"type": "string"
},
"uniqueItems": true
}
}
}
}
}
